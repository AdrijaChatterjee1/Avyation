# --- TinyFish (https://agent.tinyfish.ai/api-keys) ---
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# --- Multimodal LLM for ticket parsing + notice polishing (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Public URL of THIS backend. TinyFish drives a real browser in the cloud,
# so the demo airline portal must be reachable from the internet (use ngrok/cloudflared locally).
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS: comma-separated frontend origins ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Feature switches (only take effect when TINYFISH_API_KEY is set) ---
# Fetch live METAR through TinyFish during /api/audit-disruption (slower, uses a run)
LIVE_WEATHER=false
# Let the TinyFish web agent actually fill the airline portal in /api/execute-filing
LIVE_FILING=true
